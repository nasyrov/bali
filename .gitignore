node_modules/
dist/
.DS_Store
# OSM raw and bulk processed data; rebuilt with osmium (see docs/research/bali-osm-inventory.md),
# and the Copernicus elevation tiles the build downloads
data/raw/
data/processed/*.pbf
# except the Canggu sample, which the world build and the fixture are both cut from
!data/processed/canggu.osm.pbf
data/processed/*.geojsonseq
data/processed/*.gz

# Pipeline output (world data blobs) and build artefacts; anchored to the repository root so
# it cannot swallow a source directory that happens to be called world
/world/
*.tsbuildinfo
coverage/
.world-build/
.fixture-build/
