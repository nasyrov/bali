{
  "name": "bali-moto",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @bali-moto/game",
    "build": "npm run build --workspace @bali-moto/game",
    "preview": "npm run preview --workspace @bali-moto/game",
    "world": "npm run world --workspace @bali-moto/pipeline",
    "fixture": "npm run fixture --workspace @bali-moto/pipeline",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
